"""Compact English comparison figures, including the traditional-method difference."""
from pathlib import Path
from concurrent.futures import ProcessPoolExecutor
from collections import Counter
import argparse
import hashlib
import json
import shutil
import numpy as np
from scipy.io import loadmat
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.text import Text

ROOT = Path(__file__).resolve().parents[1]
BATCH = ROOT.parent
KEYS = ['before','after','tikhonov','diffusion']
PANEL_KEYS = ['before', 'after', 'tikhonov', 'difference', 'diffusion']
TITLES = ['Before reconstruction\nRO FFT + coil combination',
          'PhaseMap + InvA / SR\nOriginal MATLAB',
          'Tikhonov\nShared phase / coil model',
          '|Tikhonov - InvA/SR|\nAbsolute display difference',
          'Diffusion\nMouse EDM + DiffPIR']
RENDER_VERSION = 3
DIFFERENCE_MAX = .2
OVERVIEW_NAME = 'subject_groups_compact_en_diff_20260911'
plt.rcParams.update({'font.family': 'DejaVu Sans', 'font.size': 9})


def arrays(row):
    base = loadmat(BATCH/'results'/row['study']/f"scan_{row['scan_id']:03d}.mat",
                   variable_names=['before','after','fov_mm'], simplify_cells=True)
    data = {}
    for key in ['before','after']:
        a=np.asarray(base[key]);data[key]=np.abs(a.reshape(a.shape[0],a.shape[1],-1,order='F'))
    with np.load(ROOT/'results'/(row['case_id']+'.npz'),allow_pickle=False) as z:
        for key in ['tikhonov','diffusion']:
            value=z[key];assert np.isfinite(value).all();data[key]=np.clip(value,0,1)
    shape = data['before'].shape
    assert all(a.shape==shape and np.isfinite(a).all() and np.all(np.max(a,axis=(0,1))>0) for a in data.values())
    assert shape[2]==row['expected_frames']
    return data,np.ravel(base['fov_mm'])[:2]


def display_frame(data, frame):
    displayed, scales = {}, {}
    for key in KEYS:
        value = data[key][:, :, frame]
        scale = float(np.percentile(value, 99.5)) or float(value.max())
        displayed[key] = np.clip(value / scale, 0, 1)
        scales[key] = scale
    displayed['difference'] = np.abs(displayed['tikhonov'] - displayed['after'])
    return displayed, scales


def validate_layout(fig, image_axes):
    """Check actual rendered text boxes, including colorbar ticks, on every page."""
    fig.canvas.draw()
    renderer = fig.canvas.get_renderer()
    labels = [(t.get_text(), t.get_window_extent(renderer)) for t in fig.findobj(Text)
              if t.get_visible() and t.get_text().strip()]
    for i, (text, box) in enumerate(labels):
        assert not any('\u3400' <= c <= '\u9fff' for c in text), text
        assert box.x0 >= -.5 and box.y0 >= -.5 and box.x1 <= fig.bbox.width + .5 and box.y1 <= fig.bbox.height + .5, ('clipped text', text)
        for other_text, other_box in labels[:i]:
            assert not box.overlaps(other_box), ('text overlap', text, other_text)
        for ax in image_axes:
            assert not box.overlaps(ax.get_window_extent(renderer)), ('text over image', text)
    return dict(english_text=True, text_count=len(labels), text_overlaps=0,
                clipped_text=0, text_over_images=0,
                pixel_size=[int(fig.bbox.width), int(fig.bbox.height)])


def comparison_figure(items, title, overview=False):
    # Explicit physical gutters keep all images adjacent without crowding text.
    width, left, right, top, bottom = 14.4, .45, .07, .80, .31
    gaps = [.055, .055, .055, .43]  # Fourth gap holds the difference colorbar.
    column_width = (width-left-right-sum(gaps))/5
    heights = [column_width * float(item['fov'][1])/float(item['fov'][0]) for item in items]
    row_gap = .065
    height = top + bottom + sum(heights) + row_gap*(len(items)-1)
    fig = plt.figure(figsize=(width, height), dpi=140)
    fig.text(.5, (height-.075)/height, title, ha='center', va='top', fontsize=10.5)
    x_positions, x = [], left
    for j in range(5):
        x_positions.append(x)
        if j < 4: x += column_width + gaps[j]
    for x, title in zip(x_positions, TITLES):
        fig.text((x+column_width/2)/width, (height-.36)/height, title,
                 ha='center', va='top', fontsize=9.5, linespacing=1.2)
    image_axes = []
    y_top = height - top
    for item, row_height in zip(items, heights):
        y = y_top - row_height
        fov = item['fov']
        fig.text((left-.12)/width, (y+row_height/2)/height, item['label'],
                 ha='center', va='center', rotation=90, fontsize=8)
        for j, key in enumerate(PANEL_KEYS):
            ax = fig.add_axes([x_positions[j]/width, y/height, column_width/width, row_height/height])
            is_difference = key == 'difference'
            artist = ax.imshow(np.flip(item['displayed'][key], (0,1)),
                               cmap='magma' if is_difference else 'gray', vmin=0,
                               vmax=DIFFERENCE_MAX if is_difference else 1,
                               interpolation='nearest', extent=(0,fov[0],fov[1],0), aspect='equal')
            ax.set_axis_off()
            image_axes.append(ax)
            if is_difference:
                cax = fig.add_axes([(x_positions[j]+column_width+.055)/width,
                                    (y+row_height*.15)/height, .055/width, row_height*.7/height])
                bar = fig.colorbar(artist, cax=cax, ticks=[0,.05,.1,.15,.2], extend='max')
                bar.ax.set_yticklabels(['0.00','0.05','0.10','0.15','0.20'])
                bar.ax.tick_params(labelsize=6.5, length=2, pad=2)
                bar.outline.set_linewidth(.4)
        y_top = y - row_gap
    footer = 'Images: independent p99.5 scaling. Difference: absolute difference on the displayed 0-1 scale; values >0.20 saturate. No paired ground truth.'
    if overview:
        footer = 'One example per scanner subject UID; UIDs do not verify biological identity. Images: p99.5 scaling. Difference: display units, fixed 0-0.20.'
    fig.text(.5, .065/height, footer, ha='center', va='bottom', fontsize=7.5)
    check = validate_layout(fig, image_axes)
    return fig, check


def render(row):
    status = ROOT/'status'/(row['case_id']+'_methods.json')
    if not status.exists() or json.loads(status.read_text())['status']!='success':
        return dict(row,status='pending',pages=[])
    output=ROOT/'results'/(row['case_id']+'.npz')
    stamp=output.stat().st_mtime_ns
    receipt=ROOT/'validation'/(row['case_id']+'_plot.json')
    if receipt.exists():
        cached=json.loads(receipt.read_text())
        if cached.get('render_version')==RENDER_VERSION and cached['stamp']==stamp and all((BATCH/p).is_file() for p in cached['pages']):return cached
    data,fov=arrays(row);frames=row['expected_frames'];pages=[];scales=[];layout_checks=[];differences=[]
    directory=ROOT/'figures'/row['study'];directory.mkdir(parents=True,exist_ok=True)
    for start in range(0,frames,5):
        count=min(5,frames-start)
        items=[]
        for i in range(count):
            displayed,scale=display_frame(data,start+i)
            items.append(dict(displayed=displayed,fov=fov,label=f'Frame {start+i+1}/{frames}'))
            scales.append(scale)
            differences.append(dict(frame_zero_based=start+i,mae=float(displayed['difference'].mean()),
                                    maximum=float(displayed['difference'].max()),
                                    saturated_fraction=float((displayed['difference']>DIFFERENCE_MAX).mean())))
        title=f"{row['study']} / scan {row['scan_id']} | {data['before'].shape[0]} x {data['before'].shape[1]} | {row['segments']}-shot"
        fig,check=comparison_figure(items,title);layout_checks.append(check)
        target=directory/f"scan_{row['scan_id']:03d}_compact_en_diff_v3_page_{start//5+1:02d}.png"
        fig.savefig(target,dpi=140,facecolor='white');plt.close(fig);pages.append(str(target.relative_to(BATCH)))
    result=dict(row,status='success',pages=pages,frames=frames,stamp=stamp,scales=scales,render_version=RENDER_VERSION,
                layout_checks=layout_checks,differences=differences,difference_range=[0,DIFFERENCE_MAX],
                shape=list(data['before'].shape),output=str(output.relative_to(BATCH)),
                npz_sha256=hashlib.sha256(output.read_bytes()).hexdigest())
    receipt.write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\n')
    return result


def overview(rows,identity):
    chosen=[]
    for group in identity['groups']:
        candidates=[r for r in rows if r['study'] in group['studies'] and r['status']=='success']
        if not candidates:continue
        safe=[r for r in candidates if r['expected_frames']==1 and r['segments']==1]
        r=(safe or candidates)[len(safe or candidates)//2]
        if group['label']=='ID01':r=next((x for x in candidates if x['scan_id']==44 and x['study'].startswith('20231011_130630')),r)
        chosen.append((group,r))
    selected=[];items=[]
    for i,(group,row) in enumerate(chosen):
        data,fov=arrays(row);frame=row['expected_frames']//2
        displayed,_=display_frame(data,frame)
        items.append(dict(displayed=displayed,fov=fov,label=f"{group['label']} | scan {row['scan_id']} | frame {frame+1}"))
        selected.append(dict(subject_group=group['label'],case_id=row['case_id'],frame_zero_based=frame))
    fig,check=comparison_figure(items,'SPEN | 11 scanner subject UID groups | Reconstruction and traditional-method difference',overview=True)
    target=ROOT/'figures'/f'{OVERVIEW_NAME}.png'
    fig.savefig(target,dpi=140,facecolor='white');fig.savefig(target.with_suffix('.pdf'));plt.close(fig)
    (ROOT/'validation/overview_layout_validation.json').write_text(json.dumps(check,indent=2)+'\n')
    (ROOT/'figures/overview_selection.json').write_text(json.dumps(selected,ensure_ascii=False,indent=2)+'\n')


def html_page(rows,identity):
    qc={r['case_id']:r['flags'] for r in json.loads((BATCH/'qc_flags.json').read_text())}
    mapping={study:g['label'] for g in identity['groups'] for study in g['studies']}
    slim=[]
    for row in rows:
        r={k:row[k] for k in ['case_id','study','scan_id','status','expected_frames','pages','matrix','segments']}
        r.update(subject=mapping[row['study']],flags=qc[row['case_id']].copy(),
                 mat=f"results/{row['study']}/scan_{row['scan_id']:03d}.mat",npz=row.get('output',''))
        if row['matrix']!=[96,96]:r['flags'].append('Diffusion 训练网格为 96×96；本例按原生尺寸推理，未插值')
        if row['status']=='success':
            s=json.loads((ROOT/'status'/(row['case_id']+'_methods.json')).read_text())
            r['residuals']=[{'tikhonov':x['tikhonov']['clipped_residual'],'diffusion':x['diffusion']['clipped_residual']} for x in s['records']]
        slim.append(r)
    text=(ROOT/'code/gallery_template.html').read_text()
    payload=json.dumps(dict(rows=slim,identity=identity),ensure_ascii=False).replace('</','<\\/')
    text=text.replace('__PAYLOAD__',payload)
    original=BATCH/'index_original_2columns_20260910.html'
    if not original.exists():shutil.copy2(BATCH/'index.html',original)
    versioned=BATCH/'index_four_methods_20260911.html'
    previous=BATCH/'index_four_methods_before_compact_20260911.html'
    if versioned.exists() and not previous.exists():shutil.copy2(versioned,previous)
    versioned.write_text(text)
    (BATCH/'index.html.partial').write_text(text);(BATCH/'index.html.partial').replace(BATCH/'index.html')


if __name__=='__main__':
    parser=argparse.ArgumentParser();parser.add_argument('--workers',type=int,default=6);parser.add_argument('--publish',action='store_true')
    args=parser.parse_args();manifest=json.loads((BATCH/'manifest.json').read_text())
    with ProcessPoolExecutor(max_workers=args.workers) as pool:rows=list(pool.map(render,manifest))
    summary=dict(counts=dict(Counter(r['status'] for r in rows)),frames=sum(r.get('frames',0) for r in rows),
                 pages=sum(len(r['pages']) for r in rows),render_version=RENDER_VERSION,
                 panels=PANEL_KEYS,difference_range=[0,DIFFERENCE_MAX],
                 checks='Matching finite arrays; English figure text; no text overlap, clipping, or text over images on every page; native axes and reconstruction arrays retained',
                 layout_pages_checked=sum(len(r.get('layout_checks',[])) for r in rows))
    (ROOT/'validation/gallery_validation.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\n')
    if args.publish:
        assert summary['counts']=={'success':543} and summary['frames']==921
        identity=json.loads((BATCH/'subject_identity_audit.json').read_text());overview(rows,identity);html_page(rows,identity)
    print(json.dumps(summary,ensure_ascii=False),flush=True)
