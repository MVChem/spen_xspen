"""Tikhonov and the existing mouse EDM/DiffPIR from original MATLAB signals."""
from pathlib import Path
import argparse
import hashlib
import json
import sys
import time
import traceback
import numpy as np
from scipy.io import loadmat
import torch

ROOT = Path(__file__).resolve().parents[1]
BATCH = ROOT.parent
sys.path.insert(0, str(ROOT / 'source_snapshot'))
from model_v2 import load_strong_prior
from magnitude_operator import SpenMagnitudeOperator
from solvers import diffpir


def write_json(path, value):
    tmp = path.with_suffix(path.suffix + '.partial')
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    tmp.replace(path)


def physics_check(device):
    gen = torch.Generator(device=device).manual_seed(472)
    a = torch.randn(8, 8, generator=gen, device=device, dtype=torch.complex64) / 3
    coils = torch.randn(2, 8, 8, generator=gen, device=device, dtype=torch.complex64)
    op = SpenMagnitudeOperator(a, coils)
    x = torch.randn(1, 1, 8, 8, generator=gen, device=device)
    y = torch.randn(1, 2, 8, 8, generator=gen, device=device, dtype=torch.complex64)
    lhs = (op.linear(x).conj() * y).real.sum()
    rhs = (x * op.adjoint(y)).sum()
    adjoint_error = float((lhs-rhs).abs() / torch.maximum(lhs.abs(), rhs.abs()).clamp_min(1))
    z = op.proximal(x, y, .01)
    gradient = op.adjoint(op.forward(z)-y) + .01*(z-x)
    proximal_error = float(gradient.norm() / (op.adjoint(y).norm() + .01*x.norm()))
    assert adjoint_error < 1e-5 and proximal_error < 1e-5, (adjoint_error, proximal_error)
    return dict(adjoint_relative_error=adjoint_error, proximal_stationarity_error=proximal_error)


def reconstruct(row, net, device, checkpoint_hash):
    source = ROOT / 'physics' / (row['case_id'] + '.mat')
    out = ROOT / 'results' / (row['case_id'] + '.npz')
    status = ROOT / 'status' / (row['case_id'] + '_methods.json')
    if out.exists() and status.exists() and json.loads(status.read_text())['status'] == 'success':
        return
    t = time.monotonic()
    state = dict(case_id=row['case_id'], status='running', expected_frames=row['expected_frames'])
    write_json(status, state)
    try:
        mat = loadmat(source, simplify_cells=True)
        h, w = row['matrix'][1], row['matrix'][0]
        frames, count = row['expected_frames'], row['receivers']
        signal = np.asarray(mat['signal']).reshape(h, w, frames, count, order='F')
        anchors = np.asarray(mat['anchor']).reshape(h, w, frames, count, order='F')
        a = torch.as_tensor(mat['encoding'], device=device, dtype=torch.complex64)
        assert a.shape == (h, h) and h % 8 == 0 and w % 8 == 0
        smax = torch.linalg.svdvals(a).max()
        tik_outputs, diffusion_outputs, records = [], [], []
        for frame in range(frames):
            y_native = torch.as_tensor(signal[:, :, frame, :].copy(), device=device, dtype=torch.complex64).permute(2,0,1)[None]
            anchor = torch.as_tensor(anchors[:, :, frame, :].copy(), device=device, dtype=torch.complex64).permute(2,0,1)[None]
            projected = torch.einsum('ij,bcjw->bciw', a, anchor)
            gain = (projected.conj()*y_native).sum()/projected.abs().square().sum().clamp_min(1e-20)
            anchor = anchor * gain
            rss = anchor.abs().square().sum(1, keepdim=True).sqrt()
            scale = torch.quantile(rss, .995).clamp_min(1e-8)
            coils = anchor/rss.clamp_min(scale*1e-8)
            op = SpenMagnitudeOperator(a/smax, coils, sigma_noise=.02)
            y = y_native/(scale*smax)
            x_anchor = 2*rss/scale-1
            expected = torch.einsum('ij,bcjw->bciw', a, anchor)/(scale*smax)
            normalization_error = float((op.forward(x_anchor)-expected).abs().max())
            assert normalization_error < 2e-5, normalization_error
            tik = op.proximal(torch.full_like(x_anchor, -1), y, .01)
            seed = 73 + frame
            diffusion, trace = diffpir(net, op, y, steps=60, sigma_noise=.02, lamb=1., seed=seed)
            record = dict(frame_zero_based=frame, seed=seed, magnitude_scale=float(scale), encoding_smax=float(smax),
                          gain_real=float(gain.real), gain_imag=float(gain.imag), normalization_error=normalization_error,
                          anchor_residual=float(op.relative_residual(x_anchor, y)), trace=trace)
            for key, pred, target in [('tikhonov', tik, tik_outputs), ('diffusion', diffusion, diffusion_outputs)]:
                assert torch.isfinite(pred).all() and ((pred+1)/2).clamp(0,1).max()>0
                record[key] = dict(residual=float(op.relative_residual(pred,y)),
                                   clipped_residual=float(op.relative_residual(pred.clamp(-1,1),y)),
                                   outside_range_fraction=float(((pred<-1)|(pred>1)).float().mean()))
                target.append(((pred[0,0]+1)/2).cpu().numpy().astype(np.float32))
            records.append(record)
        arrays = dict(tikhonov=np.stack(tik_outputs,axis=2), diffusion=np.stack(diffusion_outputs,axis=2))
        with out.with_suffix('.npz.partial').open('wb') as handle:
            np.savez_compressed(handle, **arrays)
        out.with_suffix('.npz.partial').replace(out)
        state.update(status='success', frames=frames, shape=[h,w,frames], records=records,
                     output=str(out), checkpoint_sha256=checkpoint_hash,
                     physics_source=str(source), physics_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
                     settings=dict(tikhonov_rho=.01, diffusion_lambda=1., sigma_noise=.02, diffusion_steps=60,
                                   sigma_min=.02, sigma_max=80., xi=0., native_grid=True),
                     prior_grid_note='96x96 training; fully convolutional inference on native matrix without resampling',
                     nuisance='fixed complex coil/object phase from original MATLAB InvA anchor; global gain fitted to measurement',
                     no_spenpy_import=not any(k=='spenpy' or k.startswith('spenpy.') for k in sys.modules))
        assert state['no_spenpy_import']
    except Exception:
        state.update(status='failed', error=traceback.format_exc())
    state['elapsed_s'] = time.monotonic()-t
    write_json(status, state)
    print(json.dumps({k:state[k] for k in ['case_id','status','elapsed_s']}), flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--worker', type=int, default=0); parser.add_argument('--workers', type=int, default=1)
    parser.add_argument('--case'); parser.add_argument('--wait-for-exports', action='store_true')
    parser.add_argument('--case-list', type=Path)
    args = parser.parse_args()
    torch.set_num_threads(1)
    device = 'cuda'
    checks = physics_check(device)
    write_json(ROOT / 'validation' / f'operator_gpu_{args.worker}.json', checks)
    checkpoint = ROOT / 'source_snapshot/model_ema.pt'
    digest = hashlib.sha256(checkpoint.read_bytes()).hexdigest()
    assert digest == '25eea5af73774cf4e4e0449de7c5a83e4ee1ae236522f1441f39e8f635e904ea'
    net, ckpt = load_strong_prior(checkpoint, device)
    assert ckpt['step'] == 30000
    rows = json.loads((BATCH / 'manifest.json').read_text())[args.worker::args.workers]
    if args.case:
        rows = [r for r in rows if r['case_id']==args.case]
    if args.case_list:
        selected=set(json.loads(args.case_list.read_text()))
        rows=[r for r in rows if r['case_id'] in selected]
    with torch.no_grad():
        pending = rows[:]
        while pending:
            progressed = False
            for row in pending[:]:
                source = ROOT / 'physics' / (row['case_id'] + '.mat')
                if source.exists():
                    reconstruct(row, net, device, digest);pending.remove(row);progressed=True
                elif (ROOT / 'status' / (row['case_id']+'_export.json')).exists():
                    status = json.loads((ROOT / 'status' / (row['case_id']+'_export.json')).read_text())
                    if status['status']=='failed':
                        raise RuntimeError('MATLAB export failed: '+row['case_id']+'\n'+status['error'])
            if pending and not args.wait_for_exports:
                raise RuntimeError('Missing exports: '+str([r['case_id'] for r in pending]))
            if pending and not progressed:
                time.sleep(5)
