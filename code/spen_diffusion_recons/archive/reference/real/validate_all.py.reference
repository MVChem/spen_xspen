"""Validate coverage, original-output equivalence and complete provenance."""
from pathlib import Path
from collections import Counter
import csv
import hashlib
import json
import numpy as np
from scipy.io import loadmat

ROOT=Path(__file__).resolve().parents[1];BATCH=ROOT.parent
manifest=json.loads((BATCH/'manifest.json').read_text())
identity=json.loads((BATCH/'subject_identity_audit.json').read_text())
mapping={s:g['label'] for g in identity['groups'] for s in g['studies']}
table=[];frames=0;max_before=0.;max_after=0.;max_inverse=0.;max_normalization=0.;source_checks=[]
for row in manifest:
    case=row['case_id'];ex=json.loads((ROOT/'status'/(case+'_export.json')).read_text())
    state=json.loads((ROOT/'status'/(case+'_methods.json')).read_text())
    assert ex['status']==state['status']=='success',case
    assert state['frames']==row['expected_frames'] and len(state['records'])==row['expected_frames']
    assert state['no_spenpy_import'] and state['checkpoint_sha256']=='25eea5af73774cf4e4e0449de7c5a83e4ee1ae236522f1441f39e8f635e904ea'
    physics=ROOT/'physics'/(case+'.mat')
    assert hashlib.sha256(physics.read_bytes()).hexdigest()==state['physics_sha256']
    m=loadmat(physics,variable_names=['encoding','inverse'])
    assert m['encoding'].shape==m['inverse'].shape==(row['matrix'][1],row['matrix'][1])
    for a in m.values():
        if isinstance(a,np.ndarray):assert np.isfinite(a).all()
    original=BATCH/'results'/row['study']/f"scan_{row['scan_id']:03d}.mat"
    old=json.loads((BATCH/'validation'/(case+'.json')).read_text())
    assert hashlib.sha256(original.read_bytes()).hexdigest()==old['output_sha256'],case
    assert hashlib.sha256(Path(row['raw_file']).read_bytes()).hexdigest()==row['raw_sha256'],case
    with np.load(ROOT/'results'/(case+'.npz'),allow_pickle=False) as z:
        for key in ['tikhonov','diffusion']:
            a=z[key];assert list(a.shape)==state['shape'] and np.isfinite(a).all()
            assert np.all(np.max(np.clip(a,0,1),axis=(0,1))>0),case
    for record in state['records']:
        max_normalization=max(max_normalization,record['normalization_error'])
        assert np.isfinite(record['anchor_residual'])
        for key in ['tikhonov','diffusion']:
            assert np.isfinite(record[key]['residual']) and np.isfinite(record[key]['clipped_residual'])
    max_before=max(max_before,ex['before_error']);max_after=max(max_after,ex['after_error']);max_inverse=max(max_inverse,ex['inverse_error'])
    frames+=state['frames']
    table.append(dict(subject_group=mapping[row['study']],study=row['study'],scan_id=row['scan_id'],
                      frames=state['frames'],matrix='x'.join(map(str,row['matrix'])),format=row['format'],
                      original_matlab='complete',tikhonov='complete',diffusion='complete',
                      tikhonov_rho=.01,diffusion_steps=60,diffusion_lambda=1.,sigma_noise=.02,
                      original_mat=str(original),additional_npz=state['output'],
                      source_raw=row['raw_file'],source_raw_sha256=row['raw_sha256']))
for record in json.loads((ROOT/'source_manifest.json').read_text()):
    assert hashlib.sha256(Path(record['source']).read_bytes()).hexdigest()==record['source_sha256']
    expected=record.get('snapshot_sha256',record['source_sha256'])
    assert hashlib.sha256(Path(record['snapshot']).read_bytes()).hexdigest()==expected
    source_checks.append(record['source'])
assert len(table)==543 and frames==921 and max_normalization<2e-5
with (ROOT/'comparison_manifest.csv').open('w',newline='') as handle:
    writer=csv.DictWriter(handle,fieldnames=list(table[0]));writer.writeheader();writer.writerows(table)
summary=dict(scans=543,frames_per_method=frames,subject_uid_groups=identity['subject_uid_groups'],
             completed_methods=['original_matlab','tikhonov','diffusion'],raw_files_unchanged=543,
             original_matlab_outputs_unchanged=543,max_original_before_relative_error=max_before,
             max_original_after_relative_error=max_after,max_inverse_anchor_relative_error=max_inverse,
             max_affine_normalization_error=max_normalization,source_files_and_checkpoint_verified=len(source_checks),
             native_matrices=dict(Counter(r['matrix'] for r in table)),no_spenpy_import_in_all_inference=True,
             checkpoint_step=30000,checkpoint_sha256='25eea5af73774cf4e4e0449de7c5a83e4ee1ae236522f1441f39e8f635e904ea',
             note='Numerical validity and provenance checks do not establish biological uniqueness, image truth or physical calibration.')
(ROOT/'validation/all_methods_validation.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2)+'\n')
print(json.dumps(summary,ensure_ascii=False,indent=2))
