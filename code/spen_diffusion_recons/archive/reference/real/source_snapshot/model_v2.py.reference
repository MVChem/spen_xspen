"""Wider/deeper unconditional EDM prior with global spatial attention at 12x12."""
import sys
from pathlib import Path
import torch
from torch import nn
import torch.nn.functional as F
from tiny_unet_v2 import TinyUNet
sys.path.insert(0,str(Path(__file__).resolve().parent.parent))
from model import EDMPrior, sample_prior


class AttentionResidual(nn.Module):
    def __init__(self,block,channels,heads=8):
        super().__init__();self.block=block;self.heads=heads
        self.norm=nn.GroupNorm(8,channels)
        self.qkv=nn.Conv2d(channels,channels*3,1)
        self.proj=nn.Conv2d(channels,channels,1)
        nn.init.zeros_(self.proj.weight);nn.init.zeros_(self.proj.bias)

    def forward(self,x,embedding):
        x=self.block(x,embedding);b,c,h,w=x.shape
        qkv=self.qkv(self.norm(x)).reshape(b,3,self.heads,c//self.heads,h*w)
        q,k,v=[a.transpose(-1,-2) for a in qkv.unbind(1)]
        out=F.scaled_dot_product_attention(q,k,v).transpose(-1,-2).reshape(b,c,h,w)
        return x+self.proj(out)


class StrongPrior(EDMPrior):
    def __init__(self,base_ch=64,dropout=.10,sigma_data=.5,residual_blocks=2,attention=True):
        nn.Module.__init__(self)
        self.config=dict(base_ch=base_ch,dropout=dropout,sigma_data=sigma_data,
                         residual_blocks=residual_blocks,attention=attention)
        self.sigma_data=sigma_data
        self.net=TinyUNet(base_ch=base_ch,dropout=dropout,residual_blocks=residual_blocks)
        if attention:self.net.mid2=AttentionResidual(self.net.mid2,base_ch*4)
        nn.init.zeros_(self.net.out[-1].weight);nn.init.zeros_(self.net.out[-1].bias)


def load_strong_prior(path,device='cuda'):
    ckpt=torch.load(path,map_location='cpu',weights_only=False)
    net=StrongPrior(**ckpt['model_config']).to(device)
    net.load_state_dict(ckpt['ema']);net.eval().requires_grad_(False)
    return net,ckpt
