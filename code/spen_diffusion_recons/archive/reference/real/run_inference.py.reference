from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
import os
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
PYTHON = ROOT.parents[2] / 'spenpy/.venv/bin/python'
GPUS = [0, 1, 4, 5, 6, 7]


def run(item):
    worker, gpu = item
    env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(gpu), OMP_NUM_THREADS='1', OPENBLAS_NUM_THREADS='1')
    extra = ['--case-list',sys.argv[1]] if len(sys.argv)>1 else []
    suffix='_retry' if extra else ''
    with (ROOT / 'logs' / f'inference_{worker}{suffix}.log').open('w') as log:
        p = subprocess.run([str(PYTHON), str(ROOT / 'code/reconstruct_methods.py'),
                            '--worker', str(worker), '--workers', str(len(GPUS)), '--wait-for-exports',*extra],
                           stdout=log, stderr=subprocess.STDOUT, env=env)
    print(f'inference worker {worker} GPU {gpu}: {p.returncode}', flush=True)
    return p.returncode


if __name__ == '__main__':
    with ThreadPoolExecutor(max_workers=len(GPUS)) as pool:
        codes = list(pool.map(run, enumerate(GPUS)))
    raise SystemExit(int(any(codes)))
