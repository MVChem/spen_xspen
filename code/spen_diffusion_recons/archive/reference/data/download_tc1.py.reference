"""Download the original public Tc1/WT individual MRI volumes with checksums."""
import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import hashlib
import json
import os
from pathlib import Path
import shutil
import time

import requests

HERE = Path(__file__).resolve().parent
OUT = HERE / 'sources' / 'figshare_tc1_wt_3258139'


def digest(path, algorithm):
    value = hashlib.new(algorithm)
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(4 * 1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def download(row):
    target = OUT / row['cohort'] / row['name']
    target.parent.mkdir(parents=True, exist_ok=True)
    record = OUT / 'download_records' / (str(row['id']) + '.json')
    record.parent.mkdir(parents=True, exist_ok=True)
    md5 = row['computed_md5']
    if target.exists():
        if target.stat().st_size != row['size'] or digest(target, 'md5') != md5:
            raise ValueError(f'Existing download fails official checksum: {target}')
        if record.exists():
            print(json.dumps({'event': 'existing_verified', 'name': row['name']}), flush=True)
            return json.loads(record.read_text())
    else:
        temporary = target.with_name(target.name + '.partial')
        for attempt in range(4):
            try:
                started = time.time()
                have = temporary.stat().st_size if temporary.exists() else 0
                if have > row['size']:
                    raise ValueError(f'Oversized partial file: {temporary}')
                if have < row['size']:
                    headers = {'Range': f'bytes={have}-'} if have else {}
                    with requests.get(row['download_url'], headers=headers, stream=True,
                                      timeout=(30, 120)) as response:
                        response.raise_for_status()
                        if have and response.status_code == 206:
                            expected = f"bytes {have}-{row['size'] - 1}/{row['size']}"
                            if response.headers.get('Content-Range') != expected:
                                raise ValueError('Unexpected resume Content-Range')
                            mode = 'ab'
                        elif response.status_code == 200:
                            mode = 'wb'
                        else:
                            raise ValueError(f'Unexpected HTTP status {response.status_code}')
                        with temporary.open(mode) as stream:
                            for chunk in response.iter_content(chunk_size=1024 * 1024):
                                if chunk:
                                    if stream.tell() + len(chunk) > row['size']:
                                        raise ValueError('Oversized HTTP response')
                                    stream.write(chunk)
                if temporary.stat().st_size != row['size'] or digest(temporary, 'md5') != md5:
                    raise ValueError('Downloaded bytes or MD5 differ from official metadata')
                os.replace(temporary, target)
                print(json.dumps({'event': 'downloaded', 'name': row['name'],
                                  'bytes': row['size'], 'seconds': time.time() - started}), flush=True)
                break
            except Exception as error:
                print(json.dumps({'event': 'retry', 'name': row['name'],
                                  'attempt': attempt + 1, 'error': str(error)}), flush=True)
                if attempt == 3:
                    raise
                time.sleep(3 * (attempt + 1))
    result = dict(row, local_path=str(target.resolve()), downloaded_bytes=target.stat().st_size,
                  official_md5_verified=True, sha256=digest(target, 'sha256'), verified_at=time.time())
    temporary_record = record.with_suffix('.tmp')
    temporary_record.write_text(json.dumps(result, indent=2) + '\n')
    os.replace(temporary_record, record)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--all', action='store_true', help='All 55 individual scans after sample visual QC')
    parser.add_argument('--workers', type=int, default=4)
    args = parser.parse_args()
    OUT.mkdir(parents=True, exist_ok=True)
    rows = []
    for article, cohort in ((3382693, 'C1'), (3394786, 'C2'), (3394801, 'metadata')):
        source = HERE / 'research' / f'figshare_{article}.json'
        shutil.copyfile(source, OUT / source.name)
        data = json.loads(source.read_text())
        assert data['license']['name'] == 'CC BY 4.0'
        rows.extend(dict(row, article_id=article, cohort=cohort,
                         article_url=data['url_public_html'], license=data['license'])
                    for row in data['files'])
    metadata = [row for row in rows if row['cohort'] == 'metadata']
    images = [row for row in rows if row['name'].endswith('.nii.gz')]
    assert len(images) == 55 and len(metadata) == 1
    inventory = {'collection_url': 'https://figshare.com/collections/Tc1_and_WT_data/3258139',
                 'paper_url': 'https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0162974',
                 'scan_count': len(images), 'expected_image_bytes': sum(r['size'] for r in images),
                 'files': rows}
    (OUT / 'expected_inventory.json').write_text(json.dumps(inventory, indent=2) + '\n')
    download(metadata[0])
    selection = images if args.all else images[:1]
    errors = []
    with ThreadPoolExecutor(max_workers=min(24, max(1, args.workers))) as pool:
        futures = {pool.submit(download, row): row for row in selection}
        for future in as_completed(futures):
            try:
                future.result()
            except Exception as error:
                errors.append({'file': futures[future]['name'], 'error': str(error)})
    records = [json.loads(path.read_text()) for path in sorted((OUT / 'download_records').glob('*.json'))]
    status = dict(inventory, downloaded_records=records, errors=errors, finished_at=time.time(),
                  downloaded_image_count=sum(r['name'].endswith('.nii.gz') for r in records),
                  downloaded_bytes=sum(r['downloaded_bytes'] for r in records))
    (OUT / 'download_provenance.json').write_text(json.dumps(status, indent=2) + '\n')
    print(json.dumps({k: status[k] for k in ['downloaded_image_count', 'downloaded_bytes', 'errors']}), flush=True)
    if errors:
        raise RuntimeError('One or more downloads failed')


if __name__ == '__main__':
    main()
