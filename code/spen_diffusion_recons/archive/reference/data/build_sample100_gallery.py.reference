"""Combine two real MRI sample batches into a portable visual review gallery."""
from __future__ import annotations

import base64
import csv
import hashlib
import json
import random
import shutil
import zipfile
from collections import Counter
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw, ImageFont

BASE = Path(__file__).resolve().parent
OUT = BASE / 'sample100_coronal_20260914'
SEED = 20260914
FONT = '/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc'


def font(size):
    return ImageFont.truetype(FONT, size)


def make_sheet(records, cols, target, title):
    # 192 image pixels are shown 1:1; labels occupy separate space.
    tile_w, tile_h, margin, top = 226, 240, 18, 88
    rows = (len(records) + cols - 1) // cols
    canvas = Image.new('RGB', (margin * 2 + cols * tile_w,
                               top + rows * tile_h + margin), '#14181e')
    d = ImageDraw.Draw(canvas)
    d.text((margin, 14), title, font=font(24), fill='#f4f5f7')
    d.text((margin, 51), '真实 MRI · 冠状脑区 · 每张 192 × 192 · 编号对应 sample_index.csv',
           font=font(15), fill='#b2bbc7')
    for n, r in enumerate(records):
        x = margin + (n % cols) * tile_w
        y = top + (n // cols) * tile_h
        d.rounded_rectangle((x, y, x + tile_w - 8, y + tile_h - 8),
                            radius=6, fill='#222831')
        with Image.open(OUT / r['image_192']) as im:
            canvas.paste(im.convert('RGB'), (x + 13, y + 6))
        d.text((x + 12, y + 200), f"{r['number']:03d}  {r['label']}",
               font=font(13), fill='#f3f5f8')
        d.text((x + 12, y + 218), f"{r['subject']} · 层 {r['source_index']}",
               font=font(10), fill='#aab5c4')
    if target.suffix.lower() in ('.jpg', '.jpeg'):
        canvas.save(target, quality=95, subsampling=0)
    else:
        canvas.save(target)
    return canvas


HTML = r'''<!doctype html>
<html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>100 张小鼠冠状脑区 · 视觉抽查</title>
<style>
:root{color-scheme:dark;font-family:system-ui,"Noto Sans CJK SC",sans-serif;background:#11161c;color:#eaf0f7}
body{max-width:1400px;margin:0 auto;padding:24px}h1{font-size:25px;margin:0 0 12px}p{color:#bdc8d6;line-height:1.7;max-width:1000px}.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:22px 0}
button,input{font:inherit;border:1px solid #415064;border-radius:8px;padding:9px 15px;background:#202a37;color:inherit}button{cursor:pointer}button.active{background:#39617c;border-color:#8bc9ed}input{max-width:230px}.count{color:#a7b6c9}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:15px}.card{background:#1d2631;border:1px solid #303e50;border-radius:10px;padding:12px;text-align:left}.card img{display:block;width:192px;height:192px;max-width:100%;object-fit:contain;margin:0 auto 10px}.card b{font-size:14px}.card small{display:block;margin-top:5px;color:#a8b7cb;font-size:12px}.card:hover{border-color:#a0cbe6}
dialog{border:1px solid #50627b;border-radius:12px;background:#17212d;color:inherit;max-width:min(760px,90vw);padding:20px}dialog::backdrop{background:#000c}dialog img{display:block;margin:12px auto;width:min(576px,75vw);height:auto;image-rendering:pixelated}dialog p{font-size:14px;overflow-wrap:anywhere}dialog .toolbar{margin:8px 0}.close{margin-left:auto}.hint{font-size:13px}
</style>
<h1>100 张小鼠冠状脑区</h1>
<p>从已下载的两个 40 μm 离体来源按个体分层随机抽取：TC1/WT GRE 70 张，ds004644 FLASH 30 张，共 77 只小鼠。图像经朝向校正、脑区裁剪及等比例缩小，显示尺寸为 192 × 192。未去噪、锐化；显示灰度做了窗宽调整。</p>
<p class="hint">这批用于检查朝向、脑区占比和图像质量。EPI 未纳入。点击图像可放大，使用 ← / → 切换；放大采用最近邻显示，便于观察原有像素。</p>
<div class="toolbar"><button class="active" data-filter="all">全部 100 张</button><button data-filter="tc1">TC1 / WT · 70</button><button data-filter="ds004644">FLASH · 30</button><input id="search" placeholder="查找编号 / 个体" aria-label="查找编号或个体"><span class="count" id="count"></span></div>
<main id="grid" class="grid"></main>
<dialog id="viewer"><div class="toolbar"><button id="prev">← 上一张</button><button id="next">下一张 →</button><button class="close" id="close">关闭 ×</button></div><h2 id="title"></h2><img id="large" alt="放大的小鼠冠状脑区"><p id="details"></p><p class="hint">图像的 3 倍像素显示；编号可用于反馈需要保留或排除的样本。</p></dialog>
<script>
const records=__DATA__;let filter='all',visible=records,current=0;
const grid=document.getElementById('grid'),dialog=document.getElementById('viewer');
function render(){const q=document.getElementById('search').value.trim().toLowerCase();visible=records.filter(r=>(filter==='all'||r.group===filter)&&(!q||[String(r.number).padStart(3,'0'),r.subject,r.sample_id].join(' ').toLowerCase().includes(q)));grid.replaceChildren();visible.forEach((r,i)=>{const b=document.createElement('button');b.className='card';const img=document.createElement('img');img.src=r.data_url;img.alt=`${String(r.number).padStart(3,'0')} ${r.label} ${r.subject}`;img.loading='lazy';const title=document.createElement('b');title.textContent=`${String(r.number).padStart(3,'0')} · ${r.label}`;const meta=document.createElement('small');meta.textContent=`${r.subject} · 层 ${r.source_index}`;b.append(img,title,meta);b.onclick=()=>show(i);grid.append(b)});document.getElementById('count').textContent=`显示 ${visible.length} 张`}
function show(i){if(!visible.length)return;current=(i+visible.length)%visible.length;const r=visible[current];document.getElementById('large').src=r.data_url;document.getElementById('title').textContent=`${String(r.number).padStart(3,'0')} · ${r.label} · ${r.subject}`;document.getElementById('details').textContent=`原始体图像：${r.source} | 源轴 ${r.source_axis}，层 ${r.source_index} | ${r.sample_id}`;if(!dialog.open)dialog.showModal()}
document.querySelectorAll('[data-filter]').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));render()});document.getElementById('search').oninput=render;document.getElementById('prev').onclick=()=>show(current-1);document.getElementById('next').onclick=()=>show(current+1);document.getElementById('close').onclick=()=>dialog.close();document.addEventListener('keydown',e=>{if(dialog.open&&e.key==='ArrowLeft'){e.preventDefault();show(current-1)}if(dialog.open&&e.key==='ArrowRight'){e.preventDefault();show(current+1)}});render();
</script></html>'''


def main():
    records = []
    image_hashes = set()
    source_keys = set()
    for group, expected in [('tc1', 70), ('ds004644', 30)]:
        child = OUT / group
        manifest = json.loads((child / 'manifest.json').read_text())
        rows = manifest['records']
        assert len(rows) == expected, (group, len(rows))
        for raw in rows:
            r = dict(raw)
            r['group'] = group
            r['source_dataset'] = r['source']
            r['source'] = str(r.get('source_file', r['source']))
            source = r['source']
            assert Path(source).is_file(), source
            r['label'] = ('TC1 / ' + ('C1' if '/C1/' in source else 'C2')) if group == 'tc1' else 'FLASH'
            for key in ('image_192', 'native_roi'):
                path = Path(r[key])
                path = path if path.is_absolute() else child / path
                assert path.is_file(), path
                r[key] = str(path.relative_to(OUT))
            path = OUT / r['image_192']
            with Image.open(path) as im:
                assert im.size == (192, 192), (path, im.size)
                a = np.asarray(im)
                assert np.isfinite(a).all() and np.ptp(a) > 0, path
            roi = np.load(OUT / r['native_roi'])
            assert roi.ndim == 2 and np.isfinite(roi).all(), r['native_roi']
            assert max(roi.shape) >= 192, (r['native_roi'], roi.shape)
            r['native_roi_shape'] = list(roi.shape)
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
            assert digest not in image_hashes, ('duplicate image', path)
            image_hashes.add(digest)
            r['png_sha256'] = digest
            key = (group, source, int(r['source_axis']), int(r['source_index']))
            assert key not in source_keys, ('duplicate source layer', key)
            source_keys.add(key)
            records.append(r)
    random.Random(SEED + 1).shuffle(records)
    dest = OUT / 'images_192'
    dest.mkdir(exist_ok=True)
    for i, r in enumerate(records, 1):
        r['number'] = i
        r['flat_image'] = f'images_192/{i:03d}_{r["sample_id"]}.png'
        shutil.copyfile(OUT / r['image_192'], OUT / r['flat_image'])
    counts = Counter(r['group'] for r in records)
    animals = Counter(g for g, subject in {(r['group'], r['subject']) for r in records})
    assert len(records) == 100 and len(image_hashes) == 100 and sum(animals.values()) == 77
    summary = {'seed': SEED, 'sample_count': len(records), 'source_counts': dict(counts),
               'animal_counts': dict(animals), 'unique_animals': sum(animals.values()),
               'unique_source_layers': len(source_keys), 'unique_png_hashes': len(image_hashes),
               'image_shape': [192, 192], 'purpose': 'visual review; not a finalized training split',
               'source_resolution_um': 40, 'epi_included': False, 'records': records}
    (OUT / 'manifest.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2) + '\n')
    fields = ['number', 'sample_id', 'group', 'label', 'subject', 'source', 'source_axis',
              'source_index', 'flat_image', 'native_roi', 'native_roi_shape', 'png_sha256']
    with (OUT / 'sample_index.csv').open('w', newline='', encoding='utf-8-sig') as f:
        writer = csv.DictWriter(f, fields, extrasaction='ignore')
        writer.writeheader()
        writer.writerows(records)
    pages = []
    for p in range(4):
        pages.append(make_sheet(records[p * 25:(p + 1) * 25], 5,
                                OUT / f'page_{p + 1:02d}.png',
                                f'小鼠冠状脑区 · {p * 25 + 1:03d}–{(p + 1) * 25:03d} / 100'))
    make_sheet(records, 10, OUT / 'overview_100.jpg', '100 张小鼠冠状脑区 · TC1 / WT 70 + FLASH 30')
    pages[0].save(OUT / 'sample100.pdf', save_all=True, append_images=pages[1:], resolution=120)
    web_records = []
    for r in records:
        view = {key: r[key] for key in ('number', 'sample_id', 'group', 'label', 'subject',
                                      'source', 'source_axis', 'source_index')}
        view['data_url'] = 'data:image/png;base64,' + base64.b64encode((OUT / r['image_192']).read_bytes()).decode()
        web_records.append(view)
    (OUT / 'index.html').write_text(HTML.replace('__DATA__', json.dumps(web_records, ensure_ascii=False).replace('</', '<\\/')))
    readme = '''# 100 张小鼠 MRI 冠状脑区抽查

打开 index.html 可筛选来源并点击放大；HTML 内嵌全部 100 张图，可单独复制。
page_01.png–page_04.png 每页 25 张，sample100.pdf 为同样的四页。
images_192/ 保存 100 张带统一编号的 192×192 PNG，sample_index.csv 对照源文件、个体与层号。

固定随机种子 20260914；先覆盖 TC1/WT 的 55 只与 FLASH 的 22 只，再抽取不同层，共 70 + 30 张。
仅使用这两个 40 μm 离体图像来源的保守冠状窗口；未加入噪声 EPI、辅助 T2/MT 或重复正交视图。
进行了图像朝向校正、脑区裁剪、必要的黑色补边和等比例缩小。原始体文件未修改，未去噪或锐化。
PNG 使用灰度窗宽便于观看，属于视觉审阅版本；保留源强度单位的重采样 ROI 和逐张变换记录保存在各来源子目录。
sample100_images_192.zip 仅打包 100 张 PNG 与索引；原值 ROI、网页和拼图保存在主输出目录。
source_index 是用于定位的原生源层号；如做物理冠状重采样，具体平面与插值以子目录 manifest 为准。
本批只完成 100 张抽查，不代表 9,267 张候选已全部通过逐层 QC 或完成训练/验证/测试划分。
'''
    (OUT / 'README.md').write_text(readme)
    with zipfile.ZipFile(OUT / 'sample100_images_192.zip', 'w', zipfile.ZIP_DEFLATED) as z:
        for r in records:
            z.write(OUT / r['flat_image'], r['flat_image'])
        for name in ('sample_index.csv', 'README.md', 'manifest.json'):
            z.write(OUT / name, name)
    validation = {k: v for k, v in summary.items() if k != 'records'}
    validation['all_source_manifests_present'] = True
    validation['all_native_roi_files_finite'] = True
    validation['all_real_roi_max_dimensions_at_least_192'] = True
    validation['zip_png_count'] = len(records)
    (OUT / 'validation.json').write_text(json.dumps(validation, ensure_ascii=False, indent=2) + '\n')
    print(json.dumps(validation, ensure_ascii=False, indent=2))


if __name__ == '__main__':
    main()
