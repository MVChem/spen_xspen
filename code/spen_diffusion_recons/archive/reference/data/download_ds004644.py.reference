"""Retrieve original ds004644 spatial MRI NIfTIs and derive paired magnitude images.

MRS, git/datalad metadata, and non-image raw data are excluded. Originals are
unaltered. Only derived magnitude image headers/data are changed, in magnitude/.
Requires numpy and nibabel. Run with --all after --sample inspection.
"""
import argparse
from collections import Counter
from concurrent.futures import ThreadPoolExecutor, as_completed
import csv
import gzip
import hashlib
import io
import json
import math
import os
from pathlib import Path
import re
import shutil
import struct
import time
import xml.etree.ElementTree as ET
from urllib.parse import urlencode
from urllib.request import Request, urlopen

import numpy as np
import nibabel as nib

HERE = Path(__file__).resolve().parent
OUT = HERE / 'sources' / 'ds004644'
BASE = 'https://s3.amazonaws.com/openneuro.org/'
NS = {'s': 'http://s3.amazonaws.com/doc/2006-03-01/'}
DTYPES = {2: 'u1', 4: 'i2', 8: 'i4', 16: 'f4', 64: 'f8', 256: 'i1',
          512: 'u2', 768: 'u4', 1024: 'i8', 1280: 'u8'}


def write_json(path, obj):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(path.name + '.tmp')
    temp.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + '\n')
    os.replace(temp, path)


def digest(path, algorithm):
    h = hashlib.new(algorithm)
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(4 * 1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


def read_nifti(path, return_pixels=False):
    with gzip.open(path, 'rb') as stream:
        content = stream.read()  # Also checks gzip CRC and truncation.
    endian = '<' if struct.unpack('<i', content[:4])[0] == 348 else '>'
    assert struct.unpack(endian + 'i', content[:4])[0] == 348, 'Not NIfTI-1'
    assert content[344:348] == b'n+1\x00', 'Not single-file NIfTI'
    dimensions = struct.unpack_from(endian + '8h', content, 40)
    shape = tuple(dimensions[1:1 + dimensions[0]])
    assert len(shape) in (3, 4) and all(x > 0 for x in shape), shape
    pixdim = struct.unpack_from(endian + '8f', content, 76)
    offset = int(struct.unpack_from(endian + 'f', content, 108)[0])
    code = struct.unpack_from(endian + 'h', content, 70)[0]
    bitpix = struct.unpack_from(endian + 'h', content, 72)[0]
    dtype = np.dtype(endian + DTYPES[code])
    assert bitpix == dtype.itemsize * 8
    expected = math.prod(shape) * dtype.itemsize
    assert offset >= 352 and len(content) == offset + expected, (len(content), offset, expected)
    slope, intercept = struct.unpack_from(endian + '2f', content, 112)
    voxels = np.frombuffer(content, dtype=dtype, count=math.prod(shape), offset=offset).reshape(shape, order='F')
    if slope and np.isfinite(slope):
        voxels = voxels.astype(np.float32) * slope + intercept
    finite = bool(np.isfinite(voxels).all())
    assert finite and np.any(voxels != 0), 'Non-finite or all-zero NIfTI'
    units = content[123]
    header = dict(shape=list(shape), voxel_spacing_header=list(pixdim[1:4]),
                  spatial_units={0: 'unknown', 1: 'm', 2: 'mm', 3: 'micron'}.get(units & 7, 'unknown'),
                  datatype=code, bitpix=bitpix, voxel_offset=offset,
                  qform_code=struct.unpack_from(endian + 'h', content, 252)[0],
                  sform_code=struct.unpack_from(endian + 'h', content, 254)[0],
                  affine_srow=[list(struct.unpack_from(endian + '4f', content, k)) for k in (280, 296, 312)],
                  intensity_min=float(voxels.min()), intensity_max=float(voxels.max()),
                  finite=finite, gzip_crc_and_payload_size_verified=True,
                  voxels_nonzero=int(np.count_nonzero(voxels)))
    image = nib.load(str(path))
    assert list(image.shape) == header['shape']
    assert np.allclose(image.header.get_zooms()[:3], header['voxel_spacing_header'])
    header['orientation'] = list(nib.aff2axcodes(image.affine))
    header['affine'] = image.affine.tolist()
    header['nibabel_header_verified'] = True
    header['native_192_plane_axes'] = [axis for axis in range(3) if all(shape[other] >= 192 for other in range(3) if other != axis)]
    if return_pixels:
        return header, image.get_fdata(dtype=np.float32), image
    return header


def inventory():
    url = BASE + '?' + urlencode({'list-type': '2', 'prefix': 'ds004644/', 'max-keys': 1000})
    with urlopen(url, timeout=60) as response:
        assert response.status == 200
        content = response.read()
    root = ET.fromstring(content)
    assert root.findtext('s:IsTruncated', namespaces=NS) == 'false'
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / 's3_listing.xml').write_bytes(content)
    rows = []
    for element in root.findall('s:Contents', NS):
        key = element.findtext('s:Key', namespaces=NS)
        rel = key.removeprefix('ds004644/')
        if '/mrs/' in key:
            continue
        if not (rel.endswith(('.nii.gz', '.json')) or rel in ('README', 'CHANGES', 'participants.tsv')):
            continue
        rows.append(dict(key=key, relative_path=rel,
                         bytes=int(element.findtext('s:Size', namespaces=NS)),
                         etag=element.findtext('s:ETag', namespaces=NS).strip('"'),
                         last_modified=element.findtext('s:LastModified', namespaces=NS),
                         url=BASE + key))
    return rows


def transfer_image_segments(row, temp):
    """Resume complete byte prefixes with cache-busted, strictly validated ranges."""
    if temp.exists() and temp.stat().st_size > row['bytes']:
        temp.unlink()
    offset = temp.stat().st_size if temp.exists() else 0
    chunk_path = temp.with_name(temp.name + '.chunk')
    while offset < row['bytes']:
        end = min(offset + 16 * 1024 * 1024, row['bytes']) - 1
        # A unique query avoids intermediaries returning a different cached Range.
        url = row['url'] + '?codex_segment=' + str(time.time_ns())
        request = Request(url, headers={'Range': f'bytes={offset}-{end}'})
        with urlopen(request, timeout=120) as response:
            assert response.status == 206, f'Expected HTTP 206, received {response.status}'
            expected_range = f'bytes {offset}-{end}/{row["bytes"]}'
            assert response.headers.get('Content-Range') == expected_range, 'Wrong Content-Range'
            assert response.headers.get('ETag', '').strip('"') == row['etag'], 'Wrong source ETag'
            with chunk_path.open('wb') as stream:
                for block in iter(lambda: response.read(1024 * 1024), b''):
                    stream.write(block)
        assert chunk_path.stat().st_size == end - offset + 1, 'Truncated range response'
        with temp.open('ab') as destination, chunk_path.open('rb') as source:
            shutil.copyfileobj(source, destination, length=1024 * 1024)
        chunk_path.unlink()
        offset = temp.stat().st_size
        assert offset == end + 1, 'Partial file append size mismatch'


def download(row):
    target = OUT / row['relative_path']
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        assert target.stat().st_size == row['bytes'], f'Existing file size mismatch: {target}'
        assert digest(target, 'md5') == row['etag'], f'Existing file ETag mismatch: {target}'
    else:
        temp = target.with_name(target.name + '.partial')
        for attempt in range(4):
            try:
                started = time.time()
                if row['relative_path'].endswith('.nii.gz'):
                    transfer_image_segments(row, temp)
                else:
                    with urlopen(row['url'], timeout=120) as response:
                        assert response.status == 200 and 'Content-Range' not in response.headers, 'Partial HTTP response'
                        with temp.open('wb') as stream:
                            for block in iter(lambda: response.read(1024 * 1024), b''):
                                stream.write(block)
                assert temp.stat().st_size == row['bytes'], 'Downloaded size mismatch'
                assert '-' not in row['etag'], 'Multipart ETag cannot be treated as MD5'
                if digest(temp, 'md5') != row['etag']:
                    temp.unlink()
                    raise ValueError('Downloaded ETag/MD5 mismatch; discarded untrusted partial for full retry')
                os.replace(temp, target)
                print(json.dumps(dict(event='downloaded', path=row['relative_path'], bytes=row['bytes'], seconds=round(time.time()-started, 2))), flush=True)
                break
            except Exception as error:
                print(json.dumps(dict(event='retry', path=row['relative_path'], attempt=attempt + 1, error=str(error))), flush=True)
                if attempt == 3:
                    raise
                time.sleep(2 * (attempt + 1))
    record = dict(row, local_path=str(target), sha256=digest(target, 'sha256'),
                  etag_md5_verified=True, acquired_at_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()))
    if target.name.endswith('.nii.gz'):
        record['header'] = read_nifti(target)
        record['animal_id'] = re.search(r'(sub-[^/_]+)', row['relative_path'])[1]
        record['session'] = re.search(r'(ses-[^/_]+)', row['relative_path'])[1]
        record['sequence'] = target.name.split('_')[-1].removesuffix('.nii.gz')
        record['image_representation'] = 'imaginary' if '_part-imag_' in target.name else 'real' if '_part-real_' in target.name else 'scalar'
        record['inversion'] = 'inv-1' if '_inv-1_' in target.name else 'inv-2' if '_inv-2_' in target.name else None
        record['sequence_metadata_relative'] = row['relative_path'].replace('_part-real_', '_').replace('_part-imag_', '_').removesuffix('.nii.gz') + '.json'
        record['independent_animal_group'] = 'ds004644/' + record['animal_id']
    record_path = OUT / 'download_records' / (row['relative_path'].replace('/', '__') + '.json')
    write_json(record_path, record)
    return record


def magnitude(real_record, imag_record):
    rh, real, real_image = read_nifti(Path(real_record['local_path']), True)
    ih, imag, imag_image = read_nifti(Path(imag_record['local_path']), True)
    assert rh['shape'] == ih['shape'] and rh['voxel_spacing_header'] == ih['voxel_spacing_header']
    assert rh['affine_srow'] == ih['affine_srow']
    assert np.allclose(real_image.affine, imag_image.affine)
    per_channel_magnitude = np.hypot(real.astype(np.float32), imag.astype(np.float32))
    if per_channel_magnitude.ndim == 4:
        assert per_channel_magnitude.shape[3] == 4, 'Unexpected channel count'
        mag = np.sqrt(np.sum(per_channel_magnitude.astype(np.float64) ** 2, axis=3)).astype(np.float32)
    else:
        mag = per_channel_magnitude
    assert np.isfinite(mag).all()
    rel = real_record['relative_path'].replace('_part-real_', '_part-mag_')
    target = OUT / 'magnitude' / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    header = real_image.header.copy()
    header.set_data_dtype(np.float32)
    header.set_slope_inter(1, 0)
    header['cal_min'] = float(mag.min())
    header['cal_max'] = float(mag.max())
    header['descrip'] = b'RSS magnitude sqrt(sum(real^2+imag^2,axis=3)); ds004644'
    derived = nib.Nifti1Image(mag, real_image.affine, header=header)
    temp = target.with_name(target.name.removesuffix('.nii.gz') + '.partial.nii.gz')
    nib.save(derived, str(temp))
    os.replace(temp, target)
    record = dict(local_path=str(target), relative_path='magnitude/' + rel,
                  bytes=target.stat().st_size, sha256=digest(target, 'sha256'),
                  animal_id=real_record['animal_id'], independent_animal_group=real_record['independent_animal_group'],
                  participant=real_record.get('participant'),
                  sequence=real_record['sequence'], session=real_record['session'], inversion=real_record['inversion'],
                  image_representation='magnitude', method='sqrt(sum(real^2 + imag^2, axis=3)); NIfTI scaling applied first; float64 channel accumulation, float32 output',
                  channel_axis_interpretation='Inferred receive-coil axis: source dimension 4 has size 4 and README specifies a 4-channel phased-array receive coil. This inference is not explicit in the NIfTI sidecar.',
                  quantitative_caution='Auxiliary RSS image only; no sensitivity/noise covariance correction; MP2RAGE inversion magnitudes are not MP2RAGE UNI or quantitative T1 maps.',
                  interpolation='none; original spatial shape, spacing, affine, orientation retained; four channels RSS-combined',
                  use_for_192_hr='auxiliary only: source spatial matrices are smaller than 192; no upsampling performed',
                  source_files=[real_record['relative_path'], imag_record['relative_path']],
                  source_sha256=[real_record['sha256'], imag_record['sha256']],
                  header=read_nifti(target))
    sidecar = target.with_name(target.name.removesuffix('.nii.gz') + '.json')
    write_json(sidecar, record)
    print(json.dumps(dict(event='magnitude', path=record['relative_path'], shape=rh['shape'])), flush=True)
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--all', action='store_true', help='Download all 24 animals; each modality has 22 animals')
    parser.add_argument('--sample', action='store_true', help='Download first animal only')
    parser.add_argument('--workers', type=int, default=4)
    args = parser.parse_args()
    assert args.all != args.sample, 'Choose exactly one of --all or --sample'
    rows = inventory()
    expected = dict(dataset_url='https://openneuro.org/datasets/ds004644/versions/1.0.0',
                    dataset_doi='10.18112/openneuro.ds004644.v1.0.0', license='CC0',
                    original_image_count=sum(r['relative_path'].endswith('.nii.gz') for r in rows),
                    original_image_bytes=sum(r['bytes'] for r in rows if r['relative_path'].endswith('.nii.gz')),
                    expected_bytes=sum(r['bytes'] for r in rows),
                    exclusion='mrs spectroscopy and git/datalad metadata omitted', files=rows)
    write_json(OUT / 'expected_inventory.json', expected)
    if args.sample:
        rows = [r for r in rows if not r['relative_path'].startswith('sub-') or r['relative_path'].startswith('sub-1755a/')]
    results = []
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(download, row) for row in rows]
        for future in as_completed(futures):
            results.append(future.result())
    results.sort(key=lambda x: x['relative_path'])
    description = json.loads((OUT / 'dataset_description.json').read_text())
    assert description['License'] == 'CC0'
    participants = {r['participant_id']: r for r in csv.DictReader(io.StringIO((OUT / 'participants.tsv').read_text()), delimiter='\t')}
    originals = {r['relative_path']: r for r in results if r['relative_path'].endswith('.nii.gz')}
    magnitudes = []
    for rel, record in originals.items():
        record['participant'] = participants[record['animal_id']]
        if '_part-real_' in rel:
            magnitudes.append(magnitude(record, originals[rel.replace('_part-real_', '_part-imag_')]))
    scalar = [r for r in originals.values() if r['image_representation'] == 'scalar']
    animals = sorted({r['animal_id'] for r in originals.values()})
    summary = dict(status='complete' if args.all else 'sample_complete', license='CC0',
                   original_image_files=len(originals), original_image_bytes=sum(r['bytes'] for r in originals.values()),
                   original_scalar_volumes=len(scalar), derived_magnitude_volumes=len(magnitudes),
                   usable_scalar_and_magnitude_volumes=len(scalar)+len(magnitudes),
                   independent_animals=len(animals), animal_ids=animals,
                   participants_without_downloaded_images=sorted(set(participants)-set(animals)),
                   sequence_files=dict(Counter(r['sequence'] for r in originals.values())),
                   scalar_and_magnitude_sequences=dict(Counter(r['sequence'] for r in scalar+magnitudes)),
                   nominal_slices_axis2=sum(r['header']['shape'][2] for r in scalar+magnitudes),
                   warning='Nominal slices include peripheral/air slices. Paired real/imaginary components, inversion contrasts, and in/ex vivo scans are not independent animals. No training split/crops were generated.',
                   provenance=expected['dataset_url'])
    write_json(OUT / ('manifest.json' if args.all else 'sample_manifest.json'), dict(summary=summary, original_files=results, magnitude_files=magnitudes))
    write_json(OUT / ('download_summary.json' if args.all else 'sample_summary.json'), summary)
    print(json.dumps(summary, indent=2), flush=True)


if __name__ == '__main__':
    main()
