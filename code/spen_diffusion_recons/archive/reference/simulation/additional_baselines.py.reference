"""Add raw RSS and the project's PhaseMap + InvA baseline to frozen observations.

No clean target is supplied to either reconstruction function. The target is used
only afterwards to verify observation provenance and calculate image metrics.
"""
import argparse
import ast
import math
import types
import json
import sys
from pathlib import Path
import shutil
import time

import numpy as np
import scipy.io
import torch

OUT = Path(__file__).resolve().parent
ROOT = OUT.parent
PROJECT = ROOT.parent.parent
sys.path.insert(0, str(ROOT))
from evaluate_mouse import controlled_operator, observe, SCANS
from operators import scanner_matrices
from spenpy.core import calcInvA
from prepare_data import sha256

LEGACY = (PROJECT / 'log/0710_primary_strict_source_robust_scannerop_split20260710_seed7'
          '/source_snapshot/scripts/spen_phase_inva_0527_common.py')
# Load the original function definitions verbatim without importing unrelated
# training architectures, scanner readers or the unused skimage metric package.
needed = {'coords_grid', '_batched_linear_params', '_batched_linear', 'wrap_phase',
          'scanner_batch_phase_inputs', 'fit_tiny_phase_scanner_batch', 'apply_even_phase'}
tree = ast.parse(LEGACY.read_text())
nodes = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in needed]
assert {n.name for n in nodes} == needed
namespace = {'torch': torch, 'F': torch.nn.functional, 'math': math}
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(LEGACY), 'exec'), namespace)
legacy = types.SimpleNamespace(**namespace)


def phase_inva(y, mask, a, inv, odd_inv, even_inv, seed):
    """Measured-data phase fit, weighted InvA, per-coil measurement gain, RSS.

    y: [C, observed PE, RO]. Missing rows are zero-filled solely to call the
    full-grid phase estimator and InvA. Gain is fitted on acquired rows only.
    """
    full = y.new_zeros(4, 96, 96)
    full[:, mask] = y
    scanner = full.permute(1, 2, 0).unsqueeze(2)  # [PE, RO, slice=1, coil]
    with torch.random.fork_rng(devices=[torch.cuda.current_device()]):
        torch.manual_seed(seed)
        phase = legacy.fit_tiny_phase_scanner_batch(
            scanner[None], odd_inv, even_inv, steps=300)[0]
    corrected_scanner = legacy.apply_even_phase(scanner, phase)
    corrected = corrected_scanner[:, :, 0].permute(2, 0, 1)
    u = torch.einsum('ij,cjw->ciw', inv, corrected)
    projected = torch.einsum('ij,cjw->ciw', a[mask], u)
    measured = corrected[:, mask]
    gain = (projected.conj() * measured).sum((1, 2)) / projected.abs().square().sum((1, 2)).clamp_min(1e-12)
    coils = u * gain[:, None, None]
    magnitude = coils.abs().square().sum(0).sqrt()
    amplitude_error = float((corrected.abs() - full.abs()).abs().max())
    assert amplitude_error < 1e-6
    assert not bool(corrected[:, ~mask].abs().any())
    return magnitude, phase, corrected, coils, gain, amplitude_error


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--fovs', type=int, nargs='+', default=[16])
    args = p.parse_args()
    torch.set_num_threads(3)
    torch.backends.cuda.matmul.allow_tf32 = False
    torch.backends.cudnn.benchmark = True
    dest = OUT / 'additional_baselines'
    dest.mkdir(exist_ok=True)
    shutil.copyfile(LEGACY, dest / 'phase_source_snapshot.py')
    for fov in args.fovs:
        # Single acquisition gain maps scanner-RSS to the same unit-magnitude scale.
        # A uniform unit object with the prescribed coils is an operator calibration,
        # not any training/validation/test image. The same scale is used for R1/R2.
        op_ref = controlled_operator(fov, 1, .01, 'cuda')
        response = op_ref.forward(torch.ones(1, 1, 96, 96, device='cuda'))
        raw_scale = float(response.abs().square().sum(1).sqrt()[0, 8:-8, 8:-8].median())
        assert raw_scale > 0
        for acc, noise in [(1, .01), (2, .02)]:
            key = f'fov{fov}_R{acc}'
            source = ROOT / f'runs/evaluation_mouse_final/{key}.npz'
            arrays = np.load(source)
            records = json.loads((source.with_name(key + '_metrics.json')).read_text())['records']
            y = torch.as_tensor(arrays['observation'], device='cuda')
            op = controlled_operator(fov, acc, noise, 'cuda')
            target_check = torch.as_tensor(arrays['target'], device='cuda')[:, None] * 2 - 1
            regenerated = observe(op, target_check, noise, 9200 + fov + acc)
            observation_error = float((regenerated - y).abs().max())
            assert observation_error < 2e-6, 'Operator/coil/mask differs from frozen observations'
            del target_check, regenerated
            inv, _, _ = scanner_matrices(SCANS[fov] / 'slice_7.mat', 'cuda')
            params = scipy.io.loadmat(SCANS[fov] / 'slice_7.mat', squeeze_me=True,
                                      struct_as_record=False)['calc_inva_params']
            matrices = []
            for field in ['odd_args', 'even_args']:
                v = np.asarray(getattr(params, field)).ravel()
                mat, _ = calcInvA(v[0], v[1], int(v[2]), v[3], int(v[4]), v[5], v[6])
                matrices.append(mat.to(device='cuda', dtype=torch.complex64))
            raw, results, phases, corrected, coil_images, gains, checks = [], [], [], [], [], [], []
            t = time.monotonic()
            for j, (obs, rec) in enumerate(zip(y, records)):
                # Stable per-acquisition restart, independent of evaluation batch size.
                import hashlib
                seed = int.from_bytes(hashlib.sha256((key + ':' + rec['key'] + ':7').encode()).digest()[:4], 'little') % (2**31)
                mag, phase, yc, coils, gain, err = phase_inva(
                    obs, op.mask, op.a_full, inv, *matrices, seed)
                rss = obs.new_zeros(96, 96).real
                rss[op.mask] = obs.abs().square().sum(0).sqrt() / raw_scale
                raw.append(rss.cpu().numpy())
                results.append(mag.cpu().numpy())
                phases.append(phase.cpu().numpy())
                corrected.append(yc.cpu().numpy())
                coil_images.append(coils.cpu().numpy())
                gains.append(gain.cpu().numpy())
                checks.append(dict(index=j, key=rec['key'], seed=seed,
                                   phase_correction_amplitude_error=err,
                                   phase_rms_rad=float(phase.square().mean().sqrt())))
                if (j + 1) % 5 == 0:
                    print(json.dumps(dict(condition=key, completed=j + 1,
                                          total=len(y), seconds=round(time.monotonic() - t, 1))), flush=True)
            raw, results = np.stack(raw), np.stack(results)
            np.savez_compressed(dest / f'{key}.npz', raw_rss=raw.clip(0, 1),
                                raw_rss_unclipped=raw, phase_inva=results.clip(0, 1),
                                phase_inva_unclipped=results, phase=np.stack(phases),
                                corrected_observation=np.stack(corrected), coils=np.stack(coil_images),
                                receiver_gains=np.stack(gains), pe_mask=op.mask.cpu().numpy(),
                                encoding=op.a_full.cpu().numpy(), inv_a=inv.cpu().numpy())
            meta = dict(condition=key, source_observation_sha256=sha256(source),
                        phase_source=str(LEGACY), phase_source_sha256=sha256(LEGACY),
                        original_observation_reproduction_max_error=observation_error,
                        phase_steps=300, phase_source_function='fit_tiny_phase_scanner_batch',
                        raw_rss_calibration_scale=raw_scale,
                        raw_rss_calibration='Median RSS of forward(unit magnitude; R1 coil profile) in nominal [8:88,8:88] grid; identical scalar for R1/R2.',
                        half_sampling='Zero-fill missing rows for phase estimation and InvA; receiver gains use only observed rows.',
                        gain='Per-coil complex least-squares fit between A_normalized @ InvA @ phase_corrected_y and phase_corrected_y; no target or image-quantile scaling.',
                        note='Original controlled observations contain no added even/odd phase error. PhaseMap is still estimated from data using the original project routine. This does not test correction of real unmodeled scanner phase errors.',
                        checks=checks, seconds=time.monotonic() - t)
            (dest / f'{key}.json').write_text(json.dumps(meta, indent=2) + '\n')
    print('ADDITIONAL_BASELINES_COMPLETE', flush=True)


if __name__ == '__main__':
    main()
