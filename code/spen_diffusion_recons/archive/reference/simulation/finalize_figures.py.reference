"""Export and verify the current five-row mouse figure and refresh its bundle."""
import csv
import json
import re
import shutil
import subprocess
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from zipfile import ZIP_DEFLATED, ZipFile

import numpy as np
from PIL import Image

from make_figures import OUT, sha, write_json


def main():
    name = 'fig2_mouse123_no_flow_20260911'
    for ext in ('pdf', 'png', 'svg'):
        shutil.copy2(OUT / f'fig2_spen_inverse.{ext}', OUT / f'{name}.{ext}')
    subprocess.run(['pdftoppm', '-scale-to', '2100', '-png', '-singlefile',
                    str(OUT / f'{name}.pdf'), str(OUT / 'diagnostics' / name)], check=True)
    shutil.copy2(OUT / 'diagnostics' / f'{name}.png', OUT / 'diagnostics/fig2_pdf_render.png')
    pdf_text = subprocess.check_output(['pdftotext', '-layout', str(OUT / f'{name}.pdf'), '-'], text=True)
    assert [pdf_text.count(f'Mouse {i}') for i in (1, 2, 3)] == [2, 2, 2]
    assert not any(f'Mouse {i}' in pdf_text for i in (4, 5, 6))
    assert 'flow' not in pdf_text.lower()
    provenance = json.loads((OUT / 'provenance.json').read_text())
    wanted = Counter(f'{m["psnr"]:.2f} / {m["ssim"]:.3f}'
                     for c in provenance['figure2'] for m in c['metrics'].values())
    rendered = Counter(re.findall(r'\d+\.\d{2} / \d\.\d{3}', pdf_text))
    assert wanted == rendered and sum(rendered.values()) == 24
    arrays = dict(np.load(OUT / 'figure_arrays.npz'))
    assert 'flow' not in arrays
    assert np.array_equal(arrays['reconstruction_gt'][:3], arrays['reconstruction_gt'][3:])
    history = OUT.parent / 'figure_history/20260911_with_flow'
    previous = dict(np.load(history / 'figure_arrays.npz'))
    for key, value in arrays.items():
        assert np.array_equal(value, previous[key]), key
    with (OUT / 'all_metrics.csv').open() as f:
        rows = list(csv.DictReader(f))
    assert len(rows) == 480 and all(r['method'] != 'Flow rat model' for r in rows)
    assert list(Image.open(OUT / f'{name}.png').size) == [4320, 3960]
    for condition in ('fov16_R1', 'fov16_R2'):
        assert sha(OUT / f'flow_baseline/{condition}.npz') == sha(history / f'flow_baseline/{condition}.npz')
    write_json(OUT / 'delivery_verification.json', {
        'status': 'passed', 'checked_utc': datetime.now(timezone.utc).isoformat(),
        'latest_preview': f'diagnostics/{name}.png', 'latest_pdf': f'{name}.pdf',
        'figure_rows': ['GT', 'SPEN input RSS', 'PhaseMap + InvA', 'Tikhonov', 'Diffusion'],
        'paired_mice': [1, 2, 3], 'paired_gt_bitwise_equal': True,
        'pdf_metric_labels_verified': 24, 'all_metric_rows': 480,
        'preserved_display_arrays_bitwise_unchanged': list(arrays),
        'flow_raw_results_preserved': True, 'previous_six_row_edition': str(history),
        'latest_pdf_sha256': sha(OUT / f'{name}.pdf'),
        'latest_png_sha256': sha(OUT / f'{name}.png')})
    write_json(OUT / 'artifact_hashes.json', {
        str(p.relative_to(OUT)): sha(p) for p in sorted(OUT.rglob('*'))
        if p.is_file() and p.name != 'artifact_hashes.json' and p.suffix != '.zip'
        and '__pycache__' not in p.parts})
    archive = OUT / 'mouse_diffusion_paper_figures.zip'
    with ZipFile(archive, 'w', ZIP_DEFLATED, compresslevel=6) as z:
        for path in sorted(OUT.rglob('*')):
            if path.is_file() and path.suffix != '.zip' and '__pycache__' not in path.parts:
                z.write(path, Path('mouse_diffusion_figures') / path.relative_to(OUT))
    with ZipFile(archive) as z:
        assert z.testzip() is None
    print(json.dumps({'status': 'passed', 'preview': str(OUT / 'diagnostics' / f'{name}.png')},
                     ensure_ascii=False))


if __name__ == '__main__':
    main()
