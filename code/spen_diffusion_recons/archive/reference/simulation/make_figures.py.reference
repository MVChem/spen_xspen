"""Rebuild two publication figures from the existing mouse EDM experiment.

Run with the project's spenpy/.venv Python. No training/evaluation files are edited.
Use --resample to regenerate the floating-point training-preview samples on CUDA.
"""
import argparse
import csv
import hashlib
import json
import sys
from collections import defaultdict
from pathlib import Path

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
import nibabel as nib
import numpy as np
from PIL import Image
from scipy.ndimage import gaussian_filter

OUT = Path(__file__).resolve().parent
ROOT = OUT.parent
EVAL = ROOT / 'runs/evaluation_mouse_final'
DATA = ROOT / 'dataset_mouse'
sys.path.insert(0, str(ROOT))

TRAIN_CASES = [
    ('ds006663:sub-COMR212b', 13),
    ('ds005236:sub-03', 7),
    ('ds006663:sub-COMR331e', 18),
    ('ds002868:sub-001', 60),
    ('ds002868:sub-006', 60),
    ('ds005236:sub-33', 7),
]
# Three held-out animals, each shown with the identical GT slice in R1 and R2.
# Selection is for anatomy/source diversity, not highest reconstruction scores.
PAIRED_CASE_IDS = (3, 8, 17)
RECON_CASES = [(key, i) for key in ('fov16_R1', 'fov16_R2') for i in PAIRED_CASE_IDS]
SAMPLE_IDS = list(range(6))  # First six in the saved 12-sample training preview.
SAMPLE_ROT180 = [True, False, True, False, False, False]
INK, GRAY, ACCENT = '#20252B', '#636A72', '#205A75'
METHODS = ['raw_rss', 'phase_inva', 'tikhonov', 'V1 rat prior', 'V2 mouse prior']
FIGURE_ROWS = ['target', 'raw_rss', 'phase_inva', 'tikhonov', 'V2 mouse prior']
plt.rcParams.update({
    'font.family': 'DejaVu Sans', 'font.size': 7,
    'text.color': INK, 'axes.labelcolor': INK,
    'pdf.fonttype': 42, 'ps.fonttype': 42, 'svg.fonttype': 'none',
    'savefig.facecolor': 'white', 'figure.facecolor': 'white',
})


def sha(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def write_json(path, obj):
    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + '\n')


def image_metrics(pred, gt):
    """Existing evaluation convention, computed directly from stored [0,1] arrays."""
    pred, gt = np.asarray(pred, np.float32), np.asarray(gt, np.float32)
    mse = float(np.mean((pred - gt) ** 2))
    p, g = (gaussian_filter(a, 1.5, truncate=3.5) for a in (pred, gt))
    vp = gaussian_filter(pred * pred, 1.5, truncate=3.5) - p * p
    vg = gaussian_filter(gt * gt, 1.5, truncate=3.5) - g * g
    cov = gaussian_filter(pred * gt, 1.5, truncate=3.5) - p * g
    smap = ((2 * p * g + .01 ** 2) * (2 * cov + .03 ** 2) /
            ((p * p + g * g + .01 ** 2) * (vp + vg + .03 ** 2)))
    return {'psnr': float(-10 * np.log10(max(mse, 1e-12))),
            'ssim': float(smap[5:-5, 5:-5].mean())}


def label(fig, x, top, text, **kw):
    w, h = fig.get_size_inches()
    return fig.text(x / w, 1 - top / h, text, va='center', **kw)


def rule(fig, x0, x1, top, color='#C9CDD1', lw=.5):
    w, h = fig.get_size_inches()
    fig.add_artist(Line2D([x0 / w, x1 / w], [1 - top / h] * 2,
                         transform=fig.transFigure, color=color, lw=lw))


def tile(fig, image, left, top, side):
    w, h = fig.get_size_inches()
    ax = fig.add_axes([left / w, 1 - (top + side) / h, side / w, side / h])
    ax.imshow(image, cmap='gray', vmin=0, vmax=1, origin='upper',
              interpolation='none', aspect='equal')
    ax.set_axis_off()
    return ax


def save(fig, stem):
    fig.canvas.draw()
    renderer = fig.canvas.get_renderer()
    for item in fig.texts:
        box = item.get_window_extent(renderer)
        assert box.x0 >= 0 and box.y0 >= 0 and box.x1 <= fig.bbox.width and box.y1 <= fig.bbox.height, (
            stem, 'Text would be clipped', item.get_text())
    # PDF/SVG retain text and lines as vectors, and the native 96x96 image samples.
    fig.savefig(OUT / f'{stem}.pdf', dpi=600, metadata={
        'Title': stem, 'Creator': 'Matplotlib; reproducible local MRI figure script'})
    fig.savefig(OUT / f'{stem}.svg', dpi=600)
    fig.savefig(OUT / f'{stem}.png', dpi=600)
    fig.savefig(OUT / f'{stem}_preview.png', dpi=200)
    plt.close(fig)


def resample():
    import torch
    from model_v2 import load_strong_prior, sample_prior
    from train import save_grid
    torch.set_num_threads(3)
    torch.backends.cudnn.benchmark = True
    # Match the saved preview numerically; evaluated inference also disables TF32.
    torch.backends.cuda.matmul.allow_tf32 = False
    net, ck = load_strong_prior(ROOT / 'runs/strong_mouse96/model_ema.pt')
    x = sample_prior(net, count=12, steps=64, seed=123)
    np.savez_compressed(OUT / 'generated_samples.npz', model_range=x.cpu().numpy(),
                       magnitude=((x.cpu().numpy()[:, 0] + 1) / 2).clip(0, 1))
    # The original preview's tight_layout padding is relative to its default 10 pt font.
    with plt.rc_context(matplotlib.rcParamsDefault):
        save_grid(x, OUT / 'diagnostics/regenerated_training_grid.png', columns=6)
    write_json(OUT / 'sampling.json', {
        'step': ck['step'], 'count': 12, 'steps': 64, 'seed': 123,
        'checkpoint_sha256': sha(ROOT / 'runs/strong_mouse96/model_ema.pt'),
        'allow_tf32': False,
        'note': 'Training-preview sampler rerun with the saved EMA; floating-point arrays retained.'})


def figure_generation(gt, generated):
    fig = plt.figure(figsize=(7.2, 2.64))
    left, gap = .91, .045
    side = (7.2 - left - .06 - gap * 5) / 6
    for row, (ims, title, subtitle, prefix, color) in enumerate([
        (gt, 'Training', 'data (GT)', 'GT', INK),
        (generated, 'Diffusion', 'samples', 'G', ACCENT),
    ]):
        top = .26 + row * 1.20
        label(fig, .77, top + side / 2 - .06, title, ha='right',
              fontsize=7.7, fontweight='bold', color=color)
        label(fig, .77, top + side / 2 + .11, subtitle,
              ha='right', fontsize=7.5, color=color)
        for col, im in enumerate(ims):
            x = left + col * (side + gap)
            label(fig, x + side / 2, top - .10, f'{prefix} {col + 1}',
                  ha='center', fontsize=7, color=GRAY)
            tile(fig, im, x, top, side)
    label(fig, left, 2.565, 'Unpaired examples', fontsize=6.7, color=GRAY)
    label(fig, 7.14, 2.565, 'EDM prior  ·  30,000 training steps',
          ha='right', fontsize=6.7, color=GRAY)
    save(fig, 'fig1_generative_prior')


def figure_inverse(cases):
    fig = plt.figure(figsize=(7.2, 6.60))
    left, gap, group_gap = .91, .045, .16
    side = (7.2 - left - .06 - gap * 4 - group_gap) / 6
    xs = [left + i * (side + gap) + (group_gap - gap if i >= 3 else 0)
          for i in range(6)]
    for start, stop, letter, title, noise in [
        (0, 2, 'a', 'Full PE sampling', 'R = 1;  σ = 0.01'),
        (3, 5, 'b', '50% PE sampling', 'R = 2;  σ = 0.02'),
    ]:
        label(fig, xs[start], .105, letter, fontsize=10, fontweight='bold')
        label(fig, xs[start] + .17, .105, title, fontsize=8, fontweight='bold')
        label(fig, xs[start], .285, noise, fontsize=7.1, color=GRAY)
        rule(fig, xs[start], xs[stop] + side, .385)
    row_tops = [.62, 1.78, 2.94, 4.10, 5.26]
    for top, a, b, color in zip(row_tops,
                              ['Ground truth', 'SPEN input', 'PhaseMap', 'Tikhonov', 'Diffusion'],
                              ['(GT)', '(RSS)', '+ InvA', '', 'DiffPIR'],
                              [INK, INK, INK, INK, ACCENT]):
        label(fig, .78, top + side / 2 - .065, a, ha='right',
              fontsize=7.3, fontweight='bold', color=color)
        label(fig, .78, top + side / 2 + .105, b, ha='right',
              fontsize=7.2, color=color)
    for col, case in enumerate(cases):
        label(fig, xs[col] + side / 2, .515, f'Mouse {col % 3 + 1}',
              ha='center', fontsize=7.1, color=GRAY)
        for row, key in enumerate(FIGURE_ROWS):
            tile(fig, case['display'][key], xs[col], row_tops[row], side)
            if row:
                m = case['metrics'][key]
                label(fig, xs[col] + side / 2, row_tops[row] - .09,
                      f'{m["psnr"]:.2f} / {m["ssim"]:.3f}', ha='center',
                      fontsize=7.3, color=ACCENT if row == 4 else INK,
                      fontweight='bold' if row == 4 else 'normal')
    label(fig, left, 6.395, 'PSNR (dB) / SSIM', fontsize=6.8, color=GRAY)
    label(fig, 7.14, 6.395, 'Matched mice and slices  ·  4 coils  ·  16 mm FOV',
          fontsize=6.8, ha='right', color=GRAY)
    label(fig, left, 6.535, 'R = 2: zero-filled PE grid for SPEN input and PhaseMap + InvA.',
          fontsize=6.6, color=GRAY)
    save(fig, 'fig2_spen_inverse')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--resample', action='store_true')
    args = parser.parse_args()
    (OUT / 'diagnostics').mkdir(exist_ok=True)
    if args.resample or not (OUT / 'generated_samples.npz').exists():
        resample()
    manifest = json.loads((DATA / 'manifest.json').read_text())
    cfg = json.loads((EVAL / 'config.json').read_text())
    assert sha(DATA / 'manifest.json') == cfg['dataset_manifest_sha256']
    assert sha(ROOT / 'runs/strong_mouse96/model_ema.pt') == cfg['checkpoint_sha256']
    records = manifest['records']
    train = np.load(DATA / 'train.npy', mmap_mode='r')
    test = np.load(DATA / 'test.npy', mmap_mode='r')
    test_index = {r['key']: i for i, r in enumerate(records['test'])}
    chosen, gt = [], []
    for subject, sl in TRAIN_CASES:
        ids = [i for i, r in enumerate(records['train']) if r['subject'] == subject
               and r['slice_index'] == sl and r['view'] == 'mouse_fov16']
        assert ids
        i = sorted(ids, key=lambda j: records['train'][j]['key'])[0]
        chosen.append(dict(dataset_index=i, **records['train'][i]))
        gt.append(train[i].astype(np.float32) / 65535.)
    gt = np.stack(gt)
    raw_gen = np.load(OUT / 'generated_samples.npz')['magnitude']
    generated = np.stack([np.rot90(raw_gen[i], 2) if rot else raw_gen[i]
                          for i, rot in zip(SAMPLE_IDS, SAMPLE_ROT180)])
    old_png = np.asarray(Image.open(ROOT / 'runs/strong_mouse96/samples_030000.png'))
    new_png = np.asarray(Image.open(OUT / 'diagnostics/regenerated_training_grid.png'))
    preview_diff = np.abs(old_png.astype(float) - new_png.astype(float))
    assert preview_diff.max() <= 2, 'Regenerated sample identities differ from the training preview.'
    eval_arrays, reports, added_metadata = {}, {}, {}
    errors = defaultdict(float)
    metric_rows, summaries = [], []
    for fov in (16, 24):
        for acc in (1, 2):
            key = f'fov{fov}_R{acc}'
            arr = dict(np.load(EVAL / f'{key}.npz'))
            report = json.loads((EVAL / f'{key}_metrics.json').read_text())
            if fov == 16:
                added_path = OUT / f'additional_baselines/{key}.npz'
                extra = dict(np.load(added_path))
                meta = json.loads(added_path.with_suffix('.json').read_text())
                assert meta['source_observation_sha256'] == sha(EVAL / f'{key}.npz')
                added_metadata[key] = dict(**meta, arrays_sha256=sha(added_path))
                mask = extra['pe_mask']
                raw_check = np.zeros_like(extra['raw_rss'])
                raw_check[:, mask] = np.sqrt(np.sum(np.abs(arr['observation']) ** 2, axis=1)) / meta['raw_rss_calibration_scale']
                assert np.max(np.abs(raw_check.clip(0, 1) - extra['raw_rss'])) < 1e-6
                image_check = np.sqrt(np.sum(np.abs(extra['coils']) ** 2, axis=1)).clip(0, 1)
                assert np.max(np.abs(image_check - extra['phase_inva'])) < 1e-6
                full_y = np.zeros_like(extra['corrected_observation'])
                full_y[:, :, mask] = arr['observation']
                full_y[:, :, 1::2] *= np.exp(-1j * extra['phase'][:, None])
                assert np.max(np.abs(full_y - extra['corrected_observation'])) < 1e-6
                assert np.max(np.abs(extra['corrected_observation'][:, :, ~mask]), initial=0) == 0
                coils_check = np.einsum('ij,bcjw->bciw', extra['inv_a'], full_y) * extra['receiver_gains'][:, :, None, None]
                assert np.max(np.abs(coils_check - extra['coils'])) < 1e-5
                arr.update(raw_rss=extra['raw_rss'], phase_inva=extra['phase_inva'])
            eval_arrays[key], reports[key] = arr, report
            for j, rec in enumerate(report['records']):
                expected = test[test_index[rec['key']]].astype(np.float32) / 65535.
                if rec['rot180']:
                    expected = np.rot90(expected, 2)
                err = float(np.max(np.abs(expected - arr['target'][j])))
                errors['target_max_abs_error'] = max(errors['target_max_abs_error'], err)
                for method in [m for m in METHODS if m in arr]:
                    met = image_metrics(arr[method][j], arr['target'][j])
                    if method in report['methods']:
                        saved = report['methods'][method]['cases'][j]
                        for name in met:
                            errors[name + '_max_abs_error'] = max(
                                errors[name + '_max_abs_error'], abs(met[name] - saved[name]))
                    metric_rows.append(dict(condition=key, index=j, subject=rec['subject'],
                                            key=rec['key'], method=method, **met))
            for method in [m for m in METHODS if m in arr]:
                by_subject = defaultdict(list)
                for row in metric_rows:
                    if row['condition'] == key and row['method'] == method:
                        by_subject[row['subject']].append(row)
                vals = {name: np.array([np.mean([r[name] for r in rows])
                                        for rows in by_subject.values()]) for name in ['psnr', 'ssim']}
                summary = dict(condition=key, method=method, animals=len(by_subject),
                               slices=len(report['records']))
                for name, values in vals.items():
                    summary[name + '_mean'] = float(values.mean())
                    summary[name + '_sd_between_animal_means'] = float(values.std(ddof=1))
                    if method in report['methods']:
                        assert abs(values.mean() - report['methods'][method]['subject_mean'][name]) < 1e-5
                summaries.append(summary)
    assert errors['target_max_abs_error'] < 1e-6
    assert errors['psnr_max_abs_error'] < 1e-5 and errors['ssim_max_abs_error'] < 1e-5
    cases = []
    for key, j in RECON_CASES:
        arr, report = eval_arrays[key], reports[key]
        rec = report['records'][j]
        display, met = {}, {}
        for method in FIGURE_ROWS:
            im = arr[method][j]
            display[method] = np.rot90(im, 2) if rec['rot180'] else im
            if method != 'target':
                met[method] = image_metrics(im, arr['target'][j])
                rotated_met = image_metrics(display[method], display['target'])
                assert all(abs(rotated_met[k] - met[method][k]) < 1e-5 for k in rotated_met)
        cases.append(dict(condition=key, index=j, record=rec, display=display, metrics=met))
    assert len({c['record']['subject'] for c in cases}) == 3
    pair_checks = []
    for a, b in zip(cases[:3], cases[3:]):
        assert a['record']['key'] == b['record']['key']
        assert a['record']['subject'] == b['record']['subject']
        assert a['record']['slice_index'] == b['record']['slice_index']
        assert a['record']['rot180'] == b['record']['rot180']
        assert np.array_equal(a['display']['target'], b['display']['target'])
        pair_checks.append(dict(subject=a['record']['subject'], key=a['record']['key'],
                                slice_index=a['record']['slice_index'],
                                displayed_gt_bitwise_equal=True))
    # Check source hashes, NIfTI orientation and exact preprocessing of every displayed GT.
    from prepare_data import physical_slice
    orientation_checks = []
    for r, stored in [(r, x) for r, x in zip(chosen, gt)] + [
        (c['record'], c['display']['target']) for c in cases]:
        path = Path(r['source'])
        assert sha(path) == r['source_sha256']
        vol = nib.load(path)
        codes = nib.aff2axcodes(vol.affine)
        ap, ri, si = [next(i for i, c in enumerate(codes) if c in axis)
                      for axis in [('A', 'P'), ('R', 'L'), ('S', 'I')]]
        rem = [i for i in range(3) if i != ap]
        plane = np.take(vol.get_fdata(dtype=np.float32).squeeze(), r['slice_index'], axis=ap)
        plane = plane.transpose(rem.index(si), rem.index(ri))
        if codes[si] == 'S':
            plane = plane[::-1]
        if codes[ri] == 'R':
            plane = plane[:, ::-1]
        pix = physical_slice(plane, [vol.header.get_zooms()[i] for i in (si, ri)], 16.)
        pix = np.round(pix * 65535).astype(np.uint16).astype(np.float32) / 65535.
        err = float(np.max(np.abs(pix - stored)))
        assert err < 1e-6
        orientation_checks.append(dict(key=r['key'],native_codes=list(codes),
                                       source_sha256=r['source_sha256'],max_error=err,
                                       display='superior/dorsal up; subject-right on image-left'))
    figure_generation(gt, generated)
    figure_inverse(cases)
    np.savez_compressed(OUT / 'figure_arrays.npz', training_gt=gt, generated=generated,
                        reconstruction_gt=np.stack([c['display']['target'] for c in cases]),
                        raw_rss=np.stack([c['display']['raw_rss'] for c in cases]),
                        phase_inva=np.stack([c['display']['phase_inva'] for c in cases]),
                        tikhonov=np.stack([c['display']['tikhonov'] for c in cases]),
                        diffusion=np.stack([c['display']['V2 mouse prior'] for c in cases]))
    np.savez_compressed(OUT / 'selected_observations.npz', **{
        f'column_{i + 1}_{c["condition"]}': eval_arrays[c['condition']]['observation'][c['index']]
        for i, c in enumerate(cases)})
    for filename, rows in [('all_metrics.csv', metric_rows), ('subject_summary.csv', summaries)]:
        with (OUT / filename).open('w', newline='') as f:
            writer = csv.DictWriter(f, fieldnames=list(rows[0]))
            writer.writeheader()
            writer.writerows(rows)
    provenance = {
        'checkpoint_sha256': cfg['checkpoint_sha256'], 'checkpoint_step': 30000,
        'dataset_manifest_sha256': cfg['dataset_manifest_sha256'],
        'figure1': {'training_records': chosen, 'sample_indices_zero_based': SAMPLE_IDS,
                    'sample_display_rot180': SAMPLE_ROT180,
                    'sampling': json.loads((OUT / 'sampling.json').read_text()),
                    'selection': 'Training examples selected for source/anatomy variety; first six generated samples, no metric-based selection.',
                    'unpaired': True, 'prior_species_sampling': {'mouse': .8, 'rat': .2},
                    'note': 'Unconditional generated samples have no verified individual species or physical FOV label.'},
        'figure2': [{k: v for k, v in c.items() if k != 'display'} for c in cases],
        'figure2_pairing': {'revision_date': '2026-09-11', 'pairs': pair_checks,
                            'note': 'The same three held-out animals and exact GT slices are shown in a and b. Each condition retains its original observations and reconstructions.'},
        'display': {'vmin': 0, 'vmax': 1, 'interpolation': 'none', 'native_pixels': [96, 96],
                    'modifications': 'Only documented 180-degree display rotations; no noise added to rendered panels.'},
        'noise': {'R1': .01, 'R2': .02, 'definition': 'Standard deviation of each real/imaginary component in normalized complex measurement coordinates.'},
        'input_row': 'Multi-coil RSS of the original noisy SPEN observation; missing rows zero-filled on the nominal PE/RO grid; fixed scanner-operator scalar calibration shared across R1/R2.',
        'input_metrics': 'Reference-relative magnitude-proxy PSNR/SSIM on the nominal stationary-point PE/RO grid; raw complex measurements are preserved separately.',
        'additional_baselines': added_metadata,
        'evaluation_config': cfg,
        'parameter_selection': {k: json.loads((EVAL / f'{k}_selection.json').read_text())['selected']
                                for k in eval_arrays},
        'source_sha256': {str(p.relative_to(ROOT)): sha(p) for p in [
            ROOT / 'train_strong.py', ROOT / 'model_v2.py', ROOT / 'tiny_unet_v2.py',
            ROOT / 'evaluate_mouse.py', ROOT / 'prepare_mixed.py', DATA / 'train.npy', DATA / 'test.npy',
            *[EVAL / f'{k}.npz' for k in eval_arrays],
            *[EVAL / f'{k}_metrics.json' for k in eval_arrays],
            *[EVAL / f'{k}_selection.json' for k in eval_arrays]]},
    }
    write_json(OUT / 'provenance.json', provenance)
    write_json(OUT / 'verification.json', dict(
        status='passed', metric_comparisons=360, added_metric_pairs=120, target_comparisons=120,
        **errors, original_training_preview_pixel_mae=float(preview_diff.mean()),
        original_training_preview_pixel_max_error=float(preview_diff.max()),
        orientation_checks=orientation_checks,
        paired_panels=pair_checks,
        shared_grayscale_range=[0, 1], metric_evaluation='native resolution; fixed data_range=1',
        figure_pixel_sizes={s: list(Image.open(OUT / f'{s}.png').size) for s in
                            ['fig1_generative_prior', 'fig2_spen_inverse']}))
    write_json(OUT / 'artifact_hashes.json', {
        str(p.relative_to(OUT)): sha(p) for p in OUT.rglob('*')
        if p.is_file() and p.name != 'artifact_hashes.json' and p.suffix != '.zip'
        and '__pycache__' not in p.parts})
    print(json.dumps(dict(status='complete', output=str(OUT), metric_checks=dict(errors)), indent=2))


if __name__ == '__main__':
    main()
